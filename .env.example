# Server Settings
PORT=8000
ENVIRONMENT=development

# Database (Default is SQLite, can be switched to PostgreSQL in production)
DATABASE_URL=sqlite:///./social_ai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/social_ai_db

# LLM Providers (for post generation & refinement)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Social Media OAuth Credentials (when linking accounts)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8000/api/auth/twitter/callback
